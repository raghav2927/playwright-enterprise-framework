{
  "name": "playwright-enterprise-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable enterprise Playwright and TypeScript automation platform",
  "scripts": {
    "config:check": "tsx scripts/validate-config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}